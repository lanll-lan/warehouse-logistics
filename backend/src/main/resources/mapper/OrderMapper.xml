<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.warehouse.mapper.OrderMapper">

    <resultMap id="OrderMap" type="com.warehouse.entity.Order">
        <id property="id" column="id"/>
        <result property="orderNo" column="order_no"/>
        <result property="customerName" column="customer_name"/>
        <result property="productName" column="product_name"/>
        <result property="quantity" column="quantity"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="findAll" resultMap="OrderMap">
        SELECT * FROM orders
    </select>

    <select id="findById" resultMap="OrderMap">
        SELECT * FROM orders WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.warehouse.entity.Order" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO orders (order_no, customer_name, product_name, quantity, status)
        VALUES (#{orderNo}, #{customerName}, #{productName}, #{quantity}, #{status})
    </insert>

    <update id="update" parameterType="com.warehouse.entity.Order">
        UPDATE orders
        SET order_no = #{orderNo},
            customer_name = #{customerName},
            product_name = #{productName},
            quantity = #{quantity},
            status = #{status}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM orders WHERE id = #{id}
    </delete>

</mapper>
