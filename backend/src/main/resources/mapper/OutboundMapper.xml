<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.warehouse.mapper.OutboundMapper">

    <resultMap id="OutboundMap" type="com.warehouse.entity.Outbound">
        <id property="id" column="id"/>
        <result property="outboundNo" column="outbound_no"/>
        <result property="productName" column="product_name"/>
        <result property="quantity" column="quantity"/>
        <result property="warehouseLocation" column="warehouse_location"/>
        <result property="outboundTime" column="outbound_time"/>
    </resultMap>

    <select id="findAll" resultMap="OutboundMap">
        SELECT * FROM outbound
    </select>

    <select id="findById" resultMap="OutboundMap">
        SELECT * FROM outbound WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.warehouse.entity.Outbound" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO outbound (outbound_no, product_name, quantity, warehouse_location)
        VALUES (#{outboundNo}, #{productName}, #{quantity}, #{warehouseLocation})
    </insert>

    <update id="update" parameterType="com.warehouse.entity.Outbound">
        UPDATE outbound
        SET outbound_no = #{outboundNo},
            product_name = #{productName},
            quantity = #{quantity},
            warehouse_location = #{warehouseLocation}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM outbound WHERE id = #{id}
    </delete>

</mapper>
